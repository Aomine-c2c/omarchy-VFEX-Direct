{
  "schemaVersion": 1,
  "id": "io.github.aomine-c2c.vfex-direct",
  "name": "VFEX Direct",
  "version": "1.0.0",
  "author": "Aomine-c2c",
  "license": "MIT",
  "description": "Victoria Falls Stock Exchange (VFEX) portfolio, watchlist, and price alerts for the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "VFEX Direct",
    "category": "Finance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barMode": "Rotating",
      "rotationIntervalSec": 5,
      "refreshIntervalSec": 60,
      "panelLayout": "Dashboard (Wide)",
      "signalMarket": "Tracked Only",
      "tradingGoal": "Hybrid (Both)",
      "discountPct": 3,
      "notifySignals": true,
      "vfexFeePct": "statutory",
      "zseFeePct": "statutory",
      "maxStockPct": 25,
      "profitTakePct": 15,
      "newsEnabled": true,
      "agentEnabled": true,
      "agentZwgRate": "26.5"
    },
    "schema": [
      {
        "key": "barMode",
        "type": "enum",
        "label": "Bar ticker mode",
        "options": ["Rotating", "Portfolio", "Compact"],
        "defaultValue": "Rotating",
        "description": "Rotating cycles every few seconds through Portfolio value, watched quotes, and the top Trade Signal."
      },
      {
        "key": "rotationIntervalSec",
        "type": "integer",
        "label": "Bar rotation interval (seconds)",
        "min": 2,
        "max": 30,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Market refresh interval (seconds)",
        "min": 30,
        "max": 900,
        "step": 30,
        "defaultValue": 60
      },
      {
        "key": "panelLayout",
        "type": "enum",
        "label": "Popup panel layout",
        "options": ["Dashboard (Wide)", "Compact"],
        "defaultValue": "Dashboard (Wide)"
      },
      {
        "key": "signalMarket",
        "type": "enum",
        "label": "Trade signal & recommendation scope",
        "options": ["Tracked Only", "Tracked VFEX Only", "All Market (VFEX + ZSE)"],
        "defaultValue": "Tracked Only",
        "description": "Tracked Only limits Overview Signals, Bar ticker & alerts to your Watchlist, Holdings & Targets. Tab 2 Screener always scans all 56 counters."
      },
      {
        "key": "tradingGoal",
        "type": "enum",
        "label": "Trading goal & strategy horizon",
        "options": ["Hybrid (Both)", "Long-Term Compounder", "Short-Term Swing"],
        "defaultValue": "Hybrid (Both)",
        "description": "Adapts BUY/SELL signal scoring, holding protections, screener defaults, and UI metrics for multi-year holds, quick swings, or both."
      },
      {
        "key": "discountPct",
        "type": "integer",
        "label": "Pullback discount threshold (%)",
        "min": 1,
        "max": 20,
        "step": 1,
        "defaultValue": 3,
        "description": "Minimum % dip vs 30-day average or previous close to flag a BUY pullback idea."
      },
      {
        "key": "profitTakePct",
        "type": "integer",
        "label": "Profit-take signal threshold (%)",
        "min": 5,
        "max": 100,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "maxStockPct",
        "type": "integer",
        "label": "Max single-stock allocation cap (%)",
        "min": 5,
        "max": 100,
        "step": 5,
        "defaultValue": 25
      },
      {
        "key": "vfexFeePct",
        "type": "string",
        "label": "VFEX fee ('statutory' = Morgan & Co ~1.04%, '0.0' = gross)",
        "defaultValue": "statutory"
      },
      {
        "key": "zseFeePct",
        "type": "string",
        "label": "ZSE fee ('statutory' = C-TRADE/CGT ~2.18%, '0.0' = gross)",
        "defaultValue": "statutory"
      },
      {
        "key": "notifySignals",
        "type": "boolean",
        "label": "Desktop alerts for top trade signals",
        "defaultValue": true
      },
      {
        "key": "newsEnabled",
        "type": "boolean",
        "label": "Live VFEX/ZSE news catalysts & headline alerts",
        "defaultValue": true
      },
      {
        "key": "agentEnabled",
        "type": "boolean",
        "label": "Auto-run $100 self-learning paper agent during open hours",
        "defaultValue": true
      },
      {
        "key": "agentZwgRate",
        "type": "string",
        "label": "Paper agent ZWG/USD exchange rate (e.g. 26.5)",
        "defaultValue": "26.5"
      }
    ]
  }
}
