{
  "schemaVersion": 1,
  "id": "io.github.aomine-c2c.vfex-direct",
  "name": "VFEX Direct",
  "version": "1.0.0",
  "author": "Aomine-c2c",
  "license": "MIT",
  "description": "Victoria Falls Stock Exchange (VFEX) portfolio, watchlist, and price alerts for the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "VFEX Direct",
    "category": "Finance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barMode": "Rotating",
      "rotationIntervalSec": 5,
      "refreshIntervalSec": 60,
      "panelLayout": "Dashboard (Wide)",
      "signalMarket": "VFEX + ZSE",
      "discountPct": 3,
      "notifySignals": true,
      "vfexFeePct": "0.0",
      "zseFeePct": "0.0",
      "maxStockPct": 25,
      "profitTakePct": 15
    },
    "schema": [
      {
        "key": "barMode",
        "type": "enum",
        "label": "Bar ticker mode",
        "options": ["Rotating", "Portfolio", "Compact"],
        "defaultValue": "Rotating",
        "description": "Rotating cycles every few seconds through Portfolio value, watched quotes, and the top Trade Signal."
      },
      {
        "key": "rotationIntervalSec",
        "type": "integer",
        "label": "Bar rotation interval (seconds)",
        "min": 2,
        "max": 30,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Market refresh interval (seconds)",
        "min": 30,
        "max": 900,
        "step": 30,
        "defaultValue": 60
      },
      {
        "key": "panelLayout",
        "type": "enum",
        "label": "Popup panel layout",
        "options": ["Dashboard (Wide)", "Compact"],
        "defaultValue": "Dashboard (Wide)"
      },
      {
        "key": "signalMarket",
        "type": "enum",
        "label": "Trade signal market scope",
        "options": ["VFEX + ZSE", "VFEX Only"],
        "defaultValue": "VFEX + ZSE"
      },
      {
        "key": "discountPct",
        "type": "integer",
        "label": "Pullback discount threshold (%)",
        "min": 1,
        "max": 20,
        "step": 1,
        "defaultValue": 3,
        "description": "Minimum % dip vs 30-day average or previous close to flag a BUY pullback idea."
      },
      {
        "key": "profitTakePct",
        "type": "integer",
        "label": "Profit-take signal threshold (%)",
        "min": 5,
        "max": 100,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "maxStockPct",
        "type": "integer",
        "label": "Max single-stock allocation cap (%)",
        "min": 5,
        "max": 100,
        "step": 5,
        "defaultValue": 25
      },
      {
        "key": "vfexFeePct",
        "type": "string",
        "label": "VFEX fee per side % (e.g. 2.0, 0.0 = raw P&L)",
        "defaultValue": "0.0"
      },
      {
        "key": "zseFeePct",
        "type": "string",
        "label": "ZSE fee per side % (e.g. 2.8, 0.0 = raw P&L)",
        "defaultValue": "0.0"
      },
      {
        "key": "notifySignals",
        "type": "boolean",
        "label": "Desktop alerts for top trade signals",
        "defaultValue": true
      }
    ]
  }
}
